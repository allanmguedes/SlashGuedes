<Window x:Class="SlashText.Views.CaptureShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        xmlns:lab="clr-namespace:SlashText.Design"
        Title="{DynamicResource Ui.084E99AD5179F1EC}" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True">
    <Border Margin="18" Padding="24" Background="{DynamicResource Lab.raised}"
            lab:LabMotion.Entrance="Popup"
            BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="1" CornerRadius="11">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.38"/></Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ui.3F646D032F5913D1}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource Lab.text}"/>
                    <TextBlock Text="{DynamicResource Ui.9DB88DA47EBB035A}"
                               Style="{StaticResource Lab.Metadata}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="38" Height="38" Padding="8" Style="{StaticResource Lab.Button}"
                        ToolTip="{DynamicResource Ui.0F2BD88EF0ACBDA9}" Click="Cancel_OnClick">
                    <lab:LabIcon Kind="X" Width="17" Height="17"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
            <TextBlock Text="{DynamicResource Ui.4C2E1DF4570BEBD6}" Style="{StaticResource Lab.Metadata}" Margin="0,22,0,6"/>
            <views:ShortcutRecorderBox x:Name="MonitorBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="{DynamicResource Ui.1433152B0C58A9B9}" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,6"/>
            <views:ShortcutRecorderBox x:Name="RegionBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="{DynamicResource Ui.28014EF3525228E8}" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,6"/>
            <views:ShortcutRecorderBox x:Name="WindowBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="{DynamicResource Ui.B8A9923CBF3F1345}" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,6"/>
            <views:ShortcutRecorderBox x:Name="ScrollingBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="{DynamicResource Ui.3E9AC6ABCE93F48C}"
                       Style="{StaticResource Lab.Metadata}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <Border Height="1" Background="{DynamicResource Lab.line}" Margin="0,22,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Ui.BB9DBB406DCBD524}" Style="{StaticResource Lab.Button}" Margin="0,0,10,0" Click="Cancel_OnClick"/>
                <Button Style="{StaticResource Lab.Pilot.PrimaryButton}" Click="Save_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <lab:LabIcon Kind="Check" Width="16" Height="16" Margin="0,0,8,0"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{DynamicResource Ui.D32B31757B8B9B28}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

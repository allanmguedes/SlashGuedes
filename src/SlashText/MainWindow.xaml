                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="RefreshCw" Style="{StaticResource Lab.Icon}"/><TextBlock Text="{DynamicResource Ui.A1F09A31AD36EF78}" Style="{StaticResource Lab.Heading}" FontSize="16" Margin="9,0,0,0"/></StackPanel>
                                    <TextBlock x:Name="UpdateChannelText" Text="{DynamicResource Ui.D499472C46619CF6}" Style="{StaticResource Lab.About.Body}" Margin="0,12,0,8"/>
                                    <TextBlock x:Name="LastUpdateCheckText" Text="{DynamicResource Ui.F57D3CAF5A482C7B}" Style="{StaticResource Lab.Metadata}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LastUpdateResultText" Text="{DynamicResource Ui.9E8755B794C36115}" Style="{StaticResource Lab.About.Body}" Margin="0,5,0,10" AutomationProperties.LiveSetting="Polite"/>
                                    <WrapPanel>
                                        <Button x:Name="CheckUpdatesButton" Content="{DynamicResource Ui.493A9E9D17F8FFF2}" Style="{StaticResource Lab.Button}" Click="CheckUpdates_OnClick" Margin="0,0,8,6"/>
                                        <Button x:Name="ReleaseNotesButton" Content="{DynamicResource Ui.571F29DBC7375367}" Style="{StaticResource Lab.Button}" Visibility="Collapsed" Click="ReleaseNotes_OnClick" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="AboutPilotNoteText" Style="{StaticResource Lab.Metadata}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ShellMonitorStatusDot" Style="{StaticResource StatusDot}"/>
                    <TextBlock x:Name="ShellStatusText" Text="{DynamicResource Ui.A973C87E360C80E6}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="24,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Lab.muted}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ShellCollectionStatusText" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

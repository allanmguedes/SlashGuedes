                                </StackPanel></Border>
                                <Border Style="{StaticResource Lab.Stats.MetricCard}"><StackPanel>
                                    <lab:LabIcon Kind="Type" Width="21" Height="21" Foreground="{DynamicResource Lab.accent-text}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Caracteres poupados" Style="{StaticResource Lab.Metadata}" Margin="0,13,0,13"/>
                                    <TextBlock x:Name="CharactersSavedText" Style="{StaticResource Lab.Stats.Value}"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Lab.Stats.MetricCard}"><StackPanel>
                                    <lab:LabIcon Kind="Languages" Width="21" Height="21" Foreground="{DynamicResource Lab.accent-text}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Acentos inseridos" Style="{StaticResource Lab.Metadata}" Margin="0,13,0,13"/>
                                    <TextBlock x:Name="QuickAccentTotalText" Style="{StaticResource Lab.Stats.Value}"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Lab.Stats.MetricCard}"><StackPanel>
                                    <lab:LabIcon Kind="Camera" Width="21" Height="21" Foreground="{DynamicResource Lab.accent-text}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Capturas realizadas" Style="{StaticResource Lab.Metadata}" Margin="0,13,0,13"/>
                                    <TextBlock x:Name="CaptureTotalText" Style="{StaticResource Lab.Stats.Value}" ToolTip="Capturas que permanecem no histórico local"/>
                                </StackPanel></Border>
                            </UniformGrid>
                            <Grid x:Name="StatisticsMainGrid" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="StatisticsRankingCard" Style="{StaticResource Lab.Card}"><StackPanel>
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Keyboard" Width="18" Height="18" Foreground="{DynamicResource Lab.accent-text}" Margin="0,0,10,0"/><TextBlock Text="Atalhos mais usados" Style="{StaticResource Lab.Stats.Title}"/></StackPanel>
                                    <TextBlock Text="Até oito atalhos · barras relativas ao mais usado" Style="{StaticResource Lab.Metadata}" Margin="0,6,0,4"/>
                                    <StackPanel x:Name="StatisticsRankingPanel"/>
                                    <Border BorderBrush="{DynamicResource Lab.line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Atalhos com uso registrado" Style="{StaticResource Lab.Metadata}"/><TextBlock x:Name="UsedSnippetsText" Style="{StaticResource Lab.Text}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
                                    </Border>
                                </StackPanel></Border>
                                <Border x:Name="StatisticsCaptureCard" Grid.Column="2" Style="{StaticResource Lab.Card}"><StackPanel>
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Camera" Width="18" Height="18" Foreground="{DynamicResource Lab.accent-text}" Margin="0,0,10,0"/><TextBlock Text="Capturas por tipo" Style="{StaticResource Lab.Stats.Title}"/></StackPanel>
                                    <TextBlock x:Name="StatisticsCaptureHintText" Text="Base: capturas que permanecem no histórico local." Style="{StaticResource Lab.Metadata}" Margin="0,6,0,16"/>
                                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Região" Style="{StaticResource Lab.Metadata}"/><TextBlock x:Name="CaptureRegionTotalText" Grid.Column="1" Style="{StaticResource Lab.Text}" FontWeight="SemiBold"/></Grid>
                                    <ProgressBar x:Name="StatisticsRegionBar" Style="{StaticResource Lab.Stats.Bar}" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Monitor" Style="{StaticResource Lab.Metadata}"/><TextBlock x:Name="CaptureMonitorTotalText" Grid.Column="1" Style="{StaticResource Lab.Text}" FontWeight="SemiBold"/></Grid>
                                    <ProgressBar x:Name="StatisticsMonitorBar" Style="{StaticResource Lab.Stats.Bar}" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Janela" Style="{StaticResource Lab.Metadata}"/><TextBlock x:Name="CaptureWindowTotalText" Grid.Column="1" Style="{StaticResource Lab.Text}" FontWeight="SemiBold"/></Grid>
                                    <ProgressBar x:Name="StatisticsWindowBar" Style="{StaticResource Lab.Stats.Bar}" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="GIF" Style="{StaticResource Lab.Metadata}"/><TextBlock x:Name="CaptureGifTotalText" Grid.Column="1" Style="{StaticResource Lab.Text}" FontWeight="SemiBold"/></Grid>
                                    <ProgressBar x:Name="StatisticsGifBar" Style="{StaticResource Lab.Stats.Bar}" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MP4" Style="{StaticResource Lab.Metadata}"/><TextBlock x:Name="CaptureMp4TotalText" Grid.Column="1" Style="{StaticResource Lab.Text}" FontWeight="SemiBold"/></Grid>
                                    <ProgressBar x:Name="StatisticsMp4Bar" Style="{StaticResource Lab.Stats.Bar}" Margin="0,0,0,15"/>
                                    <TextBlock Text="Área e mídia podem se sobrepor; estes valores não formam uma soma. Captura longa e outros tipos continuam incluídos no total." Style="{StaticResource Lab.Metadata}" Margin="0,8,0,0"/>
                                </StackPanel></Border>
                            </Grid>
                            <UniformGrid x:Name="StatisticsDetailsGrid" Columns="3" Margin="-9,0,-9,0">
                                <Border Style="{StaticResource Lab.Card}" Margin="9,0,9,18"><StackPanel>
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Clock3" Width="18" Height="18" Foreground="{DynamicResource Lab.accent-text}" Margin="0,0,10,0"/><TextBlock Text="Tempo economizado" Style="{StaticResource Lab.Stats.Title}"/></StackPanel>
                                    <TextBlock x:Name="TimeSavedText" Style="{StaticResource Lab.Stats.Value}" Margin="0,16,0,8"/>
                                    <TextBlock Text="Estimativa: 200 caracteres poupados por minuto." Style="{StaticResource Lab.Metadata}"/>
                                    <TextBlock Text="Média de caracteres por expansão" Style="{StaticResource Lab.Metadata}" Margin="0,16,0,4"/>
                                    <TextBlock x:Name="AverageCharactersText" Style="{StaticResource Lab.Text}" FontWeight="SemiBold"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Lab.Card}" Margin="9,0,9,18"><StackPanel>
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Languages" Width="18" Height="18" Foreground="{DynamicResource Lab.accent-text}" Margin="0,0,10,0"/><TextBlock Text="Acentos favoritos" Style="{StaticResource Lab.Stats.Title}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8"><Border Background="{DynamicResource Lab.tint}" CornerRadius="7" Padding="12,3" MinWidth="48"><TextBlock x:Name="QuickAccentFavoriteText" Style="{StaticResource Lab.Text}" FontSize="28" Foreground="{DynamicResource Lab.accent-text}" HorizontalAlignment="Center"/></Border><TextBlock x:Name="QuickAccentFavoriteCountText" Style="{StaticResource Lab.Metadata}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock Text="Caracteres mais inseridos" Style="{StaticResource Lab.Metadata}" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="QuickAccentCharactersPanel"/>
                                </StackPanel></Border>
                                <Border x:Name="StatisticsPrivacyCard" Style="{StaticResource Lab.Card}" Margin="9,0,9,18"><StackPanel>
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="ShieldCheck" Width="18" Height="18" Foreground="{DynamicResource Lab.accent-text}" Margin="0,0,10,0"/><TextBlock Text="Privacidade" Style="{StaticResource Lab.Stats.Title}"/></StackPanel>
                                    <TextBlock Text="Somente contagens locais." Style="{StaticResource Lab.Text}" Margin="0,16,0,8"/>
                                    <TextBlock Text="Sem registrar o conteúdo digitado. Sem envio de estatísticas." Style="{StaticResource Lab.Metadata}"/>
                                    <TextBlock Text="Os dados refletem o uso acumulado e o histórico disponível, sem comparação mensal." Style="{StaticResource Lab.Metadata}" Margin="0,16,0,0"/>
                                </StackPanel></Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="1060" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Configurações" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Personalize o SlashDesk para trabalhar exatamente do seu jeito."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Aparência"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Tema do SlashDesk"
                                                   Margin="0,18,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="ThemeBox"
                                                  Margin="0,7,0,0"
                                                  SelectionChanged="ThemeBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Seguir o Windows" Tag="System"/>
                                            <ComboBoxItem Content="Claro" Tag="Light"/>
                                            <ComboBoxItem Content="Preto" Tag="Dark"/>
                                        </ComboBox>
                                        <TextBlock Text="A mudança é aplicada em todas as telas, diálogos e menus."
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Comportamento"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <CheckBox x:Name="CloseToTrayCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Manter na bandeja ao fechar"
                                                  Margin="0,16,0,7"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Iniciar com o Windows"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="ShowSuggestionsCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Mostrar sugestões ao digitar /"
                                                  Click="Settings_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Importar atalhos"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Migre seus atalhos sem recriar tudo. O SlashDesk converte formatos conhecidos e informa o que precisa de revisão."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Origem"
                                                   Margin="0,16,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="ImportSourceBox"
                                                  SelectedIndex="0"
                                                  Margin="0,7,0,0">
                                            <ComboBoxItem Content="SlashDesk (snippets.md)" Tag="SlashDesk"/>
                                            <ComboBoxItem Content="Text Blaze (JSON)" Tag="TextBlaze"/>
                                            <ComboBoxItem Content="Espanso (YAML)" Tag="Espanso"/>
                                        </ComboBox>
                                        <Button Content="Selecionar arquivo e importar"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Click="ImportSnippets_OnClick"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Antes de alterar o snippets.md, o estado atual é salvo automaticamente."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Backup e restauração"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Um ZIP local é criado por dia. O SlashDesk mantém as sete cópias mais recentes com atalhos, preferências, estatísticas e histórico."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="BackupSummaryText"
                                                   Text="Carregando backups..."
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Criar agora"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,8,8"
                                                    Click="CreateBackup_OnClick"/>
                                            <Button Content="Restaurar ZIP"
                                                    Margin="0,0,8,8"
                                                    Click="RestoreBackup_OnClick"/>
                                            <Button Content="Abrir pasta"
                                                    Margin="0,0,8,8"
                                                    Click="OpenBackupFolder_OnClick"/>
                                            <Button Content="Analisar imagens"
                                                    Margin="0,0,0,8"
                                                    ToolTip="Localizar imagens de atalhos que não estão mais em uso"
                                                    Click="AnalyzeAssets_OnClick"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="BackupLocationText"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Os backups permanecem na origem de dados selecionada. Nenhum arquivo é enviado para a nuvem."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="6" Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource StandaloneIcon}" Margin="0,0,9,0"/>
                                            <TextBlock Text="Atualizações" FontSize="17" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SettingsVersionText" Margin="0,14,0,0"
                                                   FontWeight="SemiBold" Text="Versão atual"/>
                                        <TextBlock Text="Canal estável · GitHub Releases oficiais"
                                                   Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox x:Name="CheckUpdatesCheckBox"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Content="Verificar atualizações automaticamente"
                                                  Margin="0,0,0,10"
                                                  Click="Settings_OnClick"/>
                                        <TextBlock x:Name="SettingsLastUpdateCheckText"
                                                   Text="Última verificação: ainda não verificado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsLastUpdateResultText"
                                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Text="Resultado: ainda não verificado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button x:Name="SettingsCheckUpdatesButton"
                                                Content="Verificar agora"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,0"
                                                Click="CheckUpdates_OnClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="980" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SettingsCard}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/SlashDesk.png"
                                           Width="104"
                                           Height="104"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="SlashDesk"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="32"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Texto, acentos e capturas locais para Windows"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="Versão atual · Licença MIT · código aberto"
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Feito para reduzir trabalho repetitivo"
                                           Style="{StaticResource PageTitle}"
                                           FontSize="22"/>
                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Text="Crie atalhos reutilizáveis, digite acentos em teclados internacionais e capture monitor, região ou janela com organização automática."/>
                            </StackPanel>

                            <UniformGrid Grid.Row="4" Columns="3">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Principais recursos"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Atalhos / e :, variáveis, texto formatado, Acento Rápido, monitor ativo, região, janela, atalhos globais e regras de pasta."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource StandaloneIcon}"
                                              Width="28" Height="28" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Privacidade" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Seus atalhos, estatísticas, capturas e histórico permanecem na origem de dados escolhida."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Projeto aberto"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Código disponível no GitHub para estudo, auditoria e colaboração sob a licença MIT."/>
                                        <TextBlock x:Name="UpdateChannelText"
                                                   Margin="0,12,0,0"
                                                   Text="Canal: estável"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="LastUpdateCheckText"
                                                   Margin="0,4,0,0"
                                                   Text="Última verificação: ainda não verificado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="LastUpdateResultText"
                                                   Margin="0,4,0,0"
                                                   Text="Resultado: ainda não verificado"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="Abrir projeto no GitHub"
                                                HorizontalAlignment="Left"
                                                Margin="0,14,0,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="OpenGitHub_OnClick"/>
                                        <Button x:Name="CheckUpdatesButton"
                                                Content="Verificar agora"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Click="CheckUpdates_OnClick"/>
                                        <Button x:Name="ReleaseNotesButton"
                                                Content="Visualizar notas da versão"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Visibility="Collapsed"
                                                Click="ReleaseNotes_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ShellMonitorStatusDot" Style="{StaticResource StatusDot}"/>
                    <TextBlock x:Name="ShellStatusText" Text="Monitoramento ativo"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="24,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Lab.muted}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ShellCollectionStatusText" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

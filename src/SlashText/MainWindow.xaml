<Window x:Class="SlashText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        xmlns:lab="clr-namespace:SlashText.Design"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Ui.6DC43EE9BAD493F2}"
        Icon="Assets/SlashDesk.ico"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        SizeChanged="MainWindow_OnSizeChanged"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lab.bg}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="66"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Lab.shell}"
                BorderBrush="{DynamicResource Lab.line}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                Panel.ZIndex="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/SlashDesk.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="AppTitleBarText" Text="{DynamicResource Ui.6DC43EE9BAD493F2}" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Lab.text}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="{DynamicResource Ui.C92B6D1F08B00C93}"
                            ToolTip="{DynamicResource Ui.3FC5F90B27F1ACBC}" Click="MinimizeWindow_OnClick"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="{DynamicResource Ui.AB5B6E9C1620B920}"
                            ToolTip="{DynamicResource Ui.B001BDEBDE1B1DEB}" Click="MaximizeWindow_OnClick"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="{DynamicResource Ui.A0719FC999467D86}"
                            ToolTip="{DynamicResource Ui.0F2BD88EF0ACBDA9}" Click="CloseWindow_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CaptureShellHeader" Grid.Row="1"
                Style="{StaticResource Lab.Pilot.ShellHeader}"
                Panel.ZIndex="2">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="32,0,0,0">
                <Border Style="{StaticResource BrandMark}"
                        Margin="0,0,10,0">
                    <Image Source="Assets/SlashDesk.png"
                           Width="27"
                           Height="27"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ShellPageTitle" Text="{DynamicResource Ui.4F30B1F869E56FCB}"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Lab.text}"/>
                    <TextBlock x:Name="ShellPageDescription" Text="{DynamicResource Ui.13DB1405C4D4B266}"
                               FontSize="11"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource Lab.muted}"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="StorageProtectionHeaderButton" Grid.Column="1" Visibility="Collapsed" Margin="12,0,0,0"
                    VerticalAlignment="Center" Style="{StaticResource Lab.Button}" Click="ReviewStorage_OnClick"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,32,0" VerticalAlignment="Center">
                <Border Style="{StaticResource CompactStatusPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MonitorStatusDot" Style="{StaticResource StatusDot}"/>
                        <TextBlock x:Name="MonitorStatusText" Text="{DynamicResource Ui.DC6719AD05F4C8F5}"
                                   Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="CaptureShellNavigation" Grid.Row="2"
                Style="{StaticResource Lab.Pilot.NavigationBar}">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Style>
                </Grid.Resources>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="ShortcutsTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="ShortcutsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Shortcuts}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="{DynamicResource Ui.4F30B1F869E56FCB}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CaptureTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="CaptureTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Capture}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="{DynamicResource Ui.159CF2D4E7C784F2}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickAccentTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="QuickAccentTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.QuickAccent}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="{DynamicResource Ui.BD0BB1D075558740}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClipboardTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="ClipboardTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Shortcuts}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Área de transferência"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatisticsTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="StatisticsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Statistics}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="{DynamicResource Ui.0038516D938D969A}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="SettingsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="{DynamicResource Ui.76B0FB6AD18939AC}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="AboutTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="{DynamicResource Ui.97A0FA0947AD8F6A}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WorkspaceHost" Grid.Row="3"
                Style="{StaticResource AppWorkspace}"
                Background="{DynamicResource Lab.bg}">
                <Grid>
                    <Grid x:Name="ShortcutsView" lab:LabMotion.Entrance="Page">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ShortcutHeroGap" Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid x:Name="ShortcutHero">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui.FAFFC9F796C5AA1A}" Style="{StaticResource Lab.Pilot.Eyebrow}"/>
                                <TextBlock Text="{DynamicResource Ui.BA595AC94EBAF2A6}" Style="{StaticResource Lab.Pilot.PageTitle}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="ShortcutHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ShortcutHelpButton" Style="{StaticResource Lab.Button}" Padding="10,8" Margin="0,0,8,0" Click="OpenShortcutsHelp_OnClick" ToolTip="{DynamicResource Ui.0872A41D957345A3}" AutomationProperties.Name="{DynamicResource Ui.5D10073ACCF60969}">
                                    <lab:LabIcon Kind="CircleHelp" Width="18" Height="18"/>
                                </Button>
                                <Button x:Name="ShortcutImportButton" Style="{StaticResource Lab.Button}" Margin="0,0,8,0" Click="ImportSnippets_OnClick" ToolTip="{DynamicResource Ui.E5EC4D64FD494751}">
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Upload" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource Ui.E7F0E6D956C17EC8}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel>
                                </Button>
                                <Button x:Name="ShortcutNewButton" Style="{StaticResource Lab.Pilot.PrimaryButton}" Click="NewSnippet_OnClick">
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Plus" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource Ui.4E645D573B916F13}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Lab.line}" Background="{DynamicResource Lab.panel}">
                        <Grid x:Name="ShortcutWorkspaceGrid">
                            <Grid.RowDefinitions><RowDefinition x:Name="ShortcutPrimaryRow" Height="*"/><RowDefinition x:Name="ShortcutSecondaryRow" Height="0"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ShortcutLeftColumn" Width="300" MinWidth="220" MaxWidth="460"/>
                                <ColumnDefinition x:Name="ShortcutLeftDividerColumn" Width="16"/>
                                <ColumnDefinition x:Name="ShortcutEditorColumn" Width="*" MinWidth="520"/>
                                <ColumnDefinition x:Name="ShortcutRightDividerColumn" Width="16"/>
                                <ColumnDefinition x:Name="ShortcutRightColumn" Width="280" MinWidth="240" MaxWidth="480"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ShortcutSidebarPanel" Style="{StaticResource WorkspaceSidebar}" Background="{DynamicResource Lab.shell}">
                                <Grid x:Name="ShortcutSidebarContent" Margin="18" SizeChanged="ShortcutSidebarContent_OnSizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ShortcutSidebarSearchGap" Height="24"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ShortcutSidebarCategoryGap" Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Style="{StaticResource Lab.Field}" Padding="32,9,28,9" TextChanged="SearchBox_OnTextChanged" ToolTip="{DynamicResource Ui.0D0E43169FAADACA}" AutomationProperties.Name="{DynamicResource Ui.02859A9360AD38AB}"/>
                                        <lab:LabIcon Kind="Search" Width="16" Height="16" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource Lab.muted}"/>
                                        <TextBlock x:Name="ShortcutSearchHint" Text="{DynamicResource Ui.02859A9360AD38AB}" Margin="33,0,0,0" FontSize="12" Foreground="{DynamicResource Lab.muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Button x:Name="ShortcutSearchClearButton" Style="{StaticResource Lab.Shortcuts.Ghost}" Width="28" Height="28" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" Click="ClearShortcutSearch_OnClick" ToolTip="{DynamicResource Ui.9F3EBBDE555A2C21}" AutomationProperties.Name="{DynamicResource Ui.9F3EBBDE555A2C21}">
                                            <lab:LabIcon Kind="X" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock x:Name="ShortcutCategoryHeading" Text="{DynamicResource Ui.3ADB5537C59AC03F}" Style="{StaticResource SidebarSectionTitle}" Foreground="{DynamicResource Lab.muted}" Margin="0,0,0,8"/>
                                        <ScrollViewer x:Name="ShortcutCategoriesScroll" MaxHeight="152" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CategoriesPanel"/></ScrollViewer>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock x:Name="SnippetCountText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Lab.muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Ui.1ACE550668D5985D}" Style="{StaticResource SidebarSectionTitle}" Foreground="{DynamicResource Lab.muted}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <WrapPanel x:Name="MostUsedPanel" Margin="0,8,0,0">
                                            <Button x:Name="DisplayAllButton" Content="{DynamicResource Ui.BD02B9A7D71DAC67}" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,5,0" Click="DisplayAll_OnClick"/>
                                            <Button x:Name="DisplayMostUsedButton" Content="{DynamicResource Ui.B92EAD693428C414}" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,5,4" Click="DisplayMostUsed_OnClick"/>
                                            <Button x:Name="DisplayFavoritesButton" Content="{DynamicResource Ui.AD2C8BA9AC94925F}" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,5,4" Click="DisplayFavorites_OnClick"/>
                                            <Button x:Name="DisplayPinnedButton" Content="{DynamicResource Ui.EDD6DD450D3492B5}" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,0,4" Click="DisplayPinned_OnClick"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Grid Grid.Row="6">
                                        <lab:ShortcutListBox x:Name="SnippetListPanel" Style="{StaticResource Lab.Shortcuts.List}"
                                            AutomationProperties.Name="{DynamicResource Ui.1ACE550668D5985D}"
                                            ItemContainerStyle="{StaticResource Lab.Shortcuts.ListItem}"
                                            SelectionChanged="ShortcutList_OnSelectionChanged"
                                            PreviewMouseLeftButtonDown="ShortcutList_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseRightButtonUp="ShortcutList_OnPreviewMouseRightButtonUp"
                                            PreviewKeyDown="ShortcutList_OnPreviewKeyDown"/>
                                        <StackPanel x:Name="ShortcutListEmptyPanel" Margin="4,12,4,0" Visibility="Collapsed">
                                            <TextBlock x:Name="ShortcutListEmptyHint" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource Lab.muted}"/>
                                            <Button x:Name="ShortcutListEmptyAction" Style="{StaticResource Lab.Button}" Click="ShortcutListEmpty_OnClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <GridSplitter x:Name="ShortcutLeftDivider" Grid.Column="1" Style="{StaticResource WorkspaceColumnSplitter}" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{DynamicResource Ui.3FA1523D1188C39B}" ToolTip="{DynamicResource Ui.AA73F57279C9202A}" PreviewKeyDown="ShortcutSplitter_OnPreviewKeyDown" MouseDoubleClick="ShortcutSplitter_OnMouseDoubleClick" DragStarted="ShortcutSplitter_OnDragStarted" DragCompleted="ShortcutSplitter_OnDragCompleted"/>
                            <Grid x:Name="ShortcutEditorPanel" Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel x:Name="ShortcutEditorActions" Margin="20,20,20,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ShortcutActionsButton" Style="{StaticResource Lab.Shortcuts.Tool}" Margin="0,0,5,0" Click="ShortcutActions_OnClick" ToolTip="{DynamicResource Ui.D473AD57943B66AA}" AutomationProperties.Name="{DynamicResource Ui.C018251A4C4FE977}"><lab:LabIcon Kind="MoreHorizontal" Width="18" Height="18"/></Button>
                                        <Button x:Name="ShortcutExpandEditorButton" Style="{StaticResource Lab.Shortcuts.Ghost}" Margin="0,0,5,0" Click="ToggleShortcutEditor_OnClick" ToolTip="{DynamicResource Ui.E038024EA3AF52C3}" AutomationProperties.Name="{DynamicResource Ui.E038024EA3AF52C3}"><StackPanel Orientation="Horizontal"><lab:LabIcon x:Name="ShortcutExpandEditorIcon" Kind="Maximize2" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock x:Name="ShortcutExpandEditorText" Text="{DynamicResource Ui.A2E2566DAAC9A5EB}" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
                                        <Button x:Name="ShortcutVariablesToggleButton" DockPanel.Dock="Right" Style="{StaticResource Lab.Shortcuts.Tool}" Click="ToggleShortcutVariables_OnClick" ToolTip="{DynamicResource Ui.E5C8B6D6760E9CB0}" AutomationProperties.Name="{DynamicResource Ui.084DC66025166EC5}">
                                            <lab:LabIcon Kind="PanelRight" Width="18" Height="18"/>
                                        </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <lab:LabIcon x:Name="ShortcutSaveStateIcon" Kind="Check" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource Lab.green}"/>
                                            <TextBlock x:Name="ShortcutSaveStateText" Text="{DynamicResource Ui.0C6165B25C743C1A}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Lab.green}" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </DockPanel>
                                <ScrollViewer x:Name="ShortcutEditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20">

                                    <StackPanel x:Name="ShortcutMetadataPanel">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{DynamicResource Ui.5086900635FEC3EF}" Style="{StaticResource Lab.Shortcuts.Label}"/>
                                        <TextBox x:Name="NameBox" Style="{StaticResource Lab.Field}" TextChanged="EditorField_OnTextChanged" AutomationProperties.Name="{DynamicResource Ui.D9EFB6A7909642E7}"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{DynamicResource Ui.143E52685E82BC8C}" Style="{StaticResource Lab.Shortcuts.Label}"/><TextBox x:Name="TriggerBox" Style="{StaticResource Lab.Field}" TextChanged="EditorField_OnTextChanged" AutomationProperties.Name="{DynamicResource Ui.0A55FAC858744657}"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Ui.54276AA0307F83CB}" Style="{StaticResource Lab.Shortcuts.Label}"/>
                                            <ComboBox x:Name="CategoryBox" Style="{StaticResource Lab.Combo}" IsEditable="False" MaxDropDownHeight="360" SelectionChanged="ShortcutCategory_OnSelectionChanged" AutomationProperties.Name="{DynamicResource Ui.867561DD5FFF6285}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <lab:LabIcon Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock x:Name="ShortcutLegacyCategoryHint" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Lab.muted}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{DynamicResource Ui.73E1804EB968F73E}" Style="{StaticResource Lab.Shortcuts.Label}"/>
                                        <ComboBox x:Name="FormatBox" Style="{StaticResource Lab.Combo}" SelectionChanged="FormatBox_OnSelectionChanged" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Ui.9AB11A228EB1C27E}">
                                            <ComboBoxItem Content="{DynamicResource Ui.DBA3D15AE751DFC1}"/><ComboBoxItem Content="{DynamicResource Ui.B957CF8E6FD0D1B6}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Ui.5FC119964393A660}" Style="{StaticResource Lab.Shortcuts.Label}" Margin="0,2,0,7"/>
                                    <Border BorderBrush="{DynamicResource Lab.line}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Lab.input}">
                                        <StackPanel>
                                            <StackPanel x:Name="FormattingToolbar" Visibility="Collapsed" Background="{DynamicResource Lab.raised}">
                                                <StackPanel Margin="12">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button x:Name="ShortcutUndoButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.E8908EE8F72BC8A8}" AutomationProperties.Name="{DynamicResource Ui.E8908EE8F72BC8A8}" Click="ShortcutUndo_OnClick"><lab:LabIcon Kind="Undo2" Width="18" Height="18"/></Button>
                                                            <Button x:Name="ShortcutRedoButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.189406FFE91ABCA3}" AutomationProperties.Name="{DynamicResource Ui.189406FFE91ABCA3}" Click="ShortcutRedo_OnClick"><lab:LabIcon Kind="Redo2" Width="18" Height="18"/></Button>
                                                        </StackPanel>
                                                        <TextBlock Text="{DynamicResource Ui.0892AEA16806ED17}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Lab.text}"/>
                                                    </DockPanel>
                                                    <WrapPanel>
                                                        <StackPanel Margin="0,8,16,0">
                                                            <TextBlock Text="{DynamicResource Ui.BA9617702E807CFF}" Style="{StaticResource Lab.Shortcuts.RibbonLabel}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ComboBox x:Name="FontFamilyBox" Style="{StaticResource Lab.Combo}" Width="156" MinHeight="38" Height="38" Margin="0,0,6,0" SelectedIndex="0" ToolTip="{DynamicResource Ui.3AA66CF8FDFBCEC9}" AutomationProperties.Name="{DynamicResource Ui.1BDB4ADD5DA2415F}" SelectionChanged="FontFamilyBox_OnSelectionChanged"><ComboBoxItem Content="{DynamicResource Ui.96C4069D9BB6BC73}" Tag="Segoe UI"/><ComboBoxItem Content="{DynamicResource Ui.AAC910161F16402C}" Tag="Arial"/><ComboBoxItem Content="{DynamicResource Ui.5859E9C51DEC6F20}" Tag="Calibri"/><ComboBoxItem Content="{DynamicResource Ui.4691492179D22089}" Tag="Georgia"/><ComboBoxItem Content="{DynamicResource Ui.9F52C41426605697}" Tag="Consolas"/></ComboBox>
                                                                <ComboBox x:Name="FontSizeBox" Style="{StaticResource Lab.Combo}" Width="84" MinHeight="38" Height="38" SelectedIndex="3" ToolTip="{DynamicResource Ui.276F7DC26148FF78}" AutomationProperties.Name="{DynamicResource Ui.E91C5C1CF4879736}" SelectionChanged="FontSizeBox_OnSelectionChanged"><ComboBoxItem Content="9" Tag="12"/><ComboBoxItem Content="10" Tag="13.333"/><ComboBoxItem Content="11" Tag="14.667"/><ComboBoxItem Content="12" Tag="16"/><ComboBoxItem Content="14" Tag="18.667"/><ComboBoxItem Content="16" Tag="21.333"/><ComboBoxItem Content="18" Tag="24"/><ComboBoxItem Content="24" Tag="32"/><ComboBoxItem Content="36" Tag="48"/></ComboBox>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,8,0,0">
                                                            <TextBlock Text="{DynamicResource Ui.8BC4C6CF12909FB7}" Style="{StaticResource Lab.Shortcuts.RibbonLabel}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="ShortcutBoldButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.41465F1088C0563E}" AutomationProperties.Name="{DynamicResource Ui.41465F1088C0563E}" Click="Bold_OnClick"><lab:LabIcon Kind="Bold" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutItalicButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.768FDE181D594746}" AutomationProperties.Name="{DynamicResource Ui.768FDE181D594746}" Click="Italic_OnClick"><lab:LabIcon Kind="Italic" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutUnderlineButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.9AE40042B3A4C261}" AutomationProperties.Name="{DynamicResource Ui.9AE40042B3A4C261}" Click="Underline_OnClick"><lab:LabIcon Kind="Underline" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutTextColorButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.0A06649685B47924}" AutomationProperties.Name="{DynamicResource Ui.0A06649685B47924}" Click="Color_OnClick"><lab:LabIcon Kind="Palette" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutHighlightButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="{DynamicResource Ui.01A0B53607D7E355}" AutomationProperties.Name="{DynamicResource Ui.01A0B53607D7E355}" Click="Highlight_OnClick"><lab:LabIcon Kind="Highlighter" Width="18" Height="18"/></Button>

                                                            </StackPanel>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <Border Height="1" Background="{DynamicResource Lab.line}" Margin="0,12,0,0"/>
                                                    <WrapPanel>

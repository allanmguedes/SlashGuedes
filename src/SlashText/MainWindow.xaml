<Window x:Class="SlashText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        xmlns:lab="clr-namespace:SlashText.Design"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SlashDesk"
        Icon="Assets/SlashDesk.ico"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        SizeChanged="MainWindow_OnSizeChanged"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lab.bg}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="66"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Lab.shell}"
                BorderBrush="{DynamicResource Lab.line}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                Panel.ZIndex="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/SlashDesk.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="SlashDesk" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Lab.text}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            ToolTip="Minimizar" Click="MinimizeWindow_OnClick"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            ToolTip="Maximizar ou restaurar" Click="MaximizeWindow_OnClick"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                            ToolTip="Fechar" Click="CloseWindow_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CaptureShellHeader" Grid.Row="1"
                Style="{StaticResource Lab.Pilot.ShellHeader}"
                Panel.ZIndex="2">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="32,0,0,0">
                <Border Style="{StaticResource BrandMark}"
                        Margin="0,0,10,0">
                    <Image Source="Assets/SlashDesk.png"
                           Width="27"
                           Height="27"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ShellPageTitle" Text="Atalhos"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Lab.text}"/>
                    <TextBlock x:Name="ShellPageDescription" Text="Crie, organize e edite seus textos prontos."
                               FontSize="11"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource Lab.muted}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,32,0" VerticalAlignment="Center">
                <Border Style="{StaticResource CompactStatusPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MonitorStatusDot" Style="{StaticResource StatusDot}"/>
                        <TextBlock x:Name="MonitorStatusText" Text="Iniciando monitoramento"
                                   Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="CaptureShellNavigation" Grid.Row="2"
                Style="{StaticResource Lab.Pilot.NavigationBar}">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Style>
                </Grid.Resources>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="ShortcutsTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="ShortcutsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Shortcuts}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Atalhos"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CaptureTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="CaptureTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Capture}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Captura"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickAccentTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="QuickAccentTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.QuickAccent}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Acento Rápido"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatisticsTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="StatisticsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Statistics}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Estatísticas"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="SettingsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Configurações"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutTabButton"
                            Style="{StaticResource Lab.Pilot.NavigationButton}"
                            Click="AboutTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Sobre"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WorkspaceHost" Grid.Row="3"
                Style="{StaticResource AppWorkspace}"
                Background="{DynamicResource Lab.bg}">
                <Grid>
                    <Grid x:Name="ShortcutsView" lab:LabMotion.Entrance="Page">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ShortcutHeroGap" Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid x:Name="ShortcutHero">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ESCREVA UMA VEZ" Style="{StaticResource Lab.Pilot.Eyebrow}"/>
                                <TextBlock Text="Suas palavras, prontas." Style="{StaticResource Lab.Pilot.PageTitle}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="ShortcutHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ShortcutHelpButton" Style="{StaticResource Lab.Button}" Padding="10,8" Margin="0,0,8,0" Click="OpenShortcutsHelp_OnClick" ToolTip="Como usar Atalhos" AutomationProperties.Name="Ajuda da tela Atalhos">
                                    <lab:LabIcon Kind="CircleHelp" Width="18" Height="18"/>
                                </Button>
                                <Button x:Name="ShortcutImportButton" Style="{StaticResource Lab.Button}" Margin="0,0,8,0" Click="ImportSnippets_OnClick" ToolTip="Importar do SlashDesk, Text Blaze ou Espanso; escolha a origem em Configurações">
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Upload" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="Importar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel>
                                </Button>
                                <Button x:Name="ShortcutNewButton" Style="{StaticResource Lab.Pilot.PrimaryButton}" Click="NewSnippet_OnClick">
                                    <StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Plus" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="Novo atalho" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Lab.line}" Background="{DynamicResource Lab.panel}">
                        <Grid x:Name="ShortcutWorkspaceGrid">
                            <Grid.RowDefinitions><RowDefinition x:Name="ShortcutPrimaryRow" Height="*"/><RowDefinition x:Name="ShortcutSecondaryRow" Height="0"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ShortcutLeftColumn" Width="300" MinWidth="220" MaxWidth="460"/>
                                <ColumnDefinition x:Name="ShortcutLeftDividerColumn" Width="16"/>
                                <ColumnDefinition x:Name="ShortcutEditorColumn" Width="*" MinWidth="520"/>
                                <ColumnDefinition x:Name="ShortcutRightDividerColumn" Width="16"/>
                                <ColumnDefinition x:Name="ShortcutRightColumn" Width="280" MinWidth="240" MaxWidth="480"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ShortcutSidebarPanel" Style="{StaticResource WorkspaceSidebar}" Background="{DynamicResource Lab.shell}">
                                <Grid Margin="18">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Style="{StaticResource Lab.Field}" Padding="32,9,28,9" TextChanged="SearchBox_OnTextChanged" ToolTip="Buscar por nome, conteúdo, /atalho ou categoria" AutomationProperties.Name="Buscar atalhos"/>
                                        <lab:LabIcon Kind="Search" Width="16" Height="16" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource Lab.muted}"/>
                                        <TextBlock x:Name="ShortcutSearchHint" Text="Buscar atalhos" Margin="33,0,0,0" FontSize="12" Foreground="{DynamicResource Lab.muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Button x:Name="ShortcutSearchClearButton" Style="{StaticResource Lab.Shortcuts.Ghost}" Width="28" Height="28" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" Click="ClearShortcutSearch_OnClick" ToolTip="Limpar busca" AutomationProperties.Name="Limpar busca">
                                            <lab:LabIcon Kind="X" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="CATEGORIAS" Style="{StaticResource SidebarSectionTitle}" Foreground="{DynamicResource Lab.muted}" Margin="0,0,0,8"/>
                                        <ScrollViewer MaxHeight="152" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CategoriesPanel"/></ScrollViewer>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock x:Name="SnippetCountText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Lab.muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="SEUS ATALHOS" Style="{StaticResource SidebarSectionTitle}" Foreground="{DynamicResource Lab.muted}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <WrapPanel x:Name="MostUsedPanel" Margin="0,8,0,0">
                                            <Button x:Name="DisplayAllButton" Content="Todos" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,5,0" Click="DisplayAll_OnClick"/>
                                            <Button x:Name="DisplayMostUsedButton" Content="Mais usados" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,5,4" Click="DisplayMostUsed_OnClick"/>
                                            <Button x:Name="DisplayFavoritesButton" Content="Favoritos" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,5,4" Click="DisplayFavorites_OnClick"/>
                                            <Button x:Name="DisplayPinnedButton" Content="Fixados" Style="{StaticResource Lab.Shortcuts.Filter}" Margin="0,0,0,4" Click="DisplayPinned_OnClick"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SnippetListPanel"/></ScrollViewer>
                                </Grid>
                            </Grid>
                            <GridSplitter x:Name="ShortcutLeftDivider" Grid.Column="1" Style="{StaticResource WorkspaceColumnSplitter}" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Redimensionar lista de atalhos e editor" ToolTip="Arraste. ←/→ ajusta; Home ou clique duplo restaura." PreviewKeyDown="ShortcutSplitter_OnPreviewKeyDown" MouseDoubleClick="ShortcutSplitter_OnMouseDoubleClick" DragStarted="ShortcutSplitter_OnDragStarted" DragCompleted="ShortcutSplitter_OnDragCompleted"/>
                            <Grid x:Name="ShortcutEditorPanel" Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel x:Name="ShortcutEditorActions" Margin="20,20,20,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ShortcutActionsButton" Style="{StaticResource Lab.Shortcuts.Tool}" Margin="0,0,5,0" Click="ShortcutActions_OnClick" ToolTip="Duplicar, favoritar ou fixar" AutomationProperties.Name="Opções do atalho"><lab:LabIcon Kind="MoreHorizontal" Width="18" Height="18"/></Button>
                                        <Button x:Name="ShortcutExpandEditorButton" Style="{StaticResource Lab.Shortcuts.Ghost}" Margin="0,0,5,0" Click="ToggleShortcutEditor_OnClick" ToolTip="Expandir ou recolher o editor" AutomationProperties.Name="Expandir ou recolher o editor"><StackPanel Orientation="Horizontal"><lab:LabIcon x:Name="ShortcutExpandEditorIcon" Kind="Maximize2" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock x:Name="ShortcutExpandEditorText" Text="Expandir editor" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
                                        <Button x:Name="ShortcutVariablesToggleButton" DockPanel.Dock="Right" Style="{StaticResource Lab.Shortcuts.Tool}" Click="ToggleShortcutVariables_OnClick" ToolTip="Mostrar ou ocultar variáveis" AutomationProperties.Name="Mostrar ou ocultar painel de variáveis">
                                            <lab:LabIcon Kind="PanelRight" Width="18" Height="18"/>
                                        </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <lab:LabIcon x:Name="ShortcutSaveStateIcon" Kind="Check" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource Lab.green}"/>
                                            <TextBlock x:Name="ShortcutSaveStateText" Text="Tudo salvo" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Lab.green}" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </DockPanel>
                                <ScrollViewer x:Name="ShortcutEditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20">

                                    <StackPanel x:Name="ShortcutMetadataPanel">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Nome" Style="{StaticResource Lab.Shortcuts.Label}"/>
                                        <TextBox x:Name="NameBox" Style="{StaticResource Lab.Field}" TextChanged="EditorField_OnTextChanged" AutomationProperties.Name="Nome do atalho"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Comando" Style="{StaticResource Lab.Shortcuts.Label}"/><TextBox x:Name="TriggerBox" Style="{StaticResource Lab.Field}" TextChanged="EditorField_OnTextChanged" AutomationProperties.Name="Comando do atalho"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Categoria" Style="{StaticResource Lab.Shortcuts.Label}"/>
                                            <ComboBox x:Name="CategoryBox" Style="{StaticResource Lab.Combo}" IsEditable="False" MaxDropDownHeight="360" SelectionChanged="ShortcutCategory_OnSelectionChanged" AutomationProperties.Name="Categoria do atalho">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <lab:LabIcon Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock x:Name="ShortcutLegacyCategoryHint" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Lab.muted}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Formato" Style="{StaticResource Lab.Shortcuts.Label}"/>
                                        <ComboBox x:Name="FormatBox" Style="{StaticResource Lab.Combo}" SelectionChanged="FormatBox_OnSelectionChanged" SelectedIndex="0" AutomationProperties.Name="Formato do conteúdo">
                                            <ComboBoxItem Content="Texto simples"/><ComboBoxItem Content="Texto formatado"/>
                                        </ComboBox>
                                    </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Conteúdo" Style="{StaticResource Lab.Shortcuts.Label}" Margin="0,2,0,7"/>
                                    <Border BorderBrush="{DynamicResource Lab.line}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Lab.input}">
                                        <StackPanel>
                                            <StackPanel x:Name="FormattingToolbar" Visibility="Collapsed" Background="{DynamicResource Lab.raised}">
                                                <StackPanel Margin="12">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button x:Name="ShortcutUndoButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Desfazer (Ctrl+Z)" AutomationProperties.Name="Desfazer (Ctrl+Z)" Click="ShortcutUndo_OnClick"><lab:LabIcon Kind="Undo2" Width="18" Height="18"/></Button>
                                                            <Button x:Name="ShortcutRedoButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Refazer (Ctrl+Y)" AutomationProperties.Name="Refazer (Ctrl+Y)" Click="ShortcutRedo_OnClick"><lab:LabIcon Kind="Redo2" Width="18" Height="18"/></Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Formatação" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Lab.text}"/>
                                                    </DockPanel>
                                                    <WrapPanel>
                                                        <StackPanel Margin="0,8,16,0">
                                                            <TextBlock Text="FONTE E TAMANHO" Style="{StaticResource Lab.Shortcuts.RibbonLabel}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ComboBox x:Name="FontFamilyBox" Style="{StaticResource Lab.Combo}" Width="156" MinHeight="38" Height="38" Margin="0,0,6,0" SelectedIndex="0" ToolTip="Fonte do texto selecionado" AutomationProperties.Name="Fonte" SelectionChanged="FontFamilyBox_OnSelectionChanged"><ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/><ComboBoxItem Content="Arial" Tag="Arial"/><ComboBoxItem Content="Calibri" Tag="Calibri"/><ComboBoxItem Content="Georgia" Tag="Georgia"/><ComboBoxItem Content="Consolas" Tag="Consolas"/></ComboBox>
                                                                <ComboBox x:Name="FontSizeBox" Style="{StaticResource Lab.Combo}" Width="84" MinHeight="38" Height="38" SelectedIndex="3" ToolTip="Tamanho da fonte em pontos; padrão 12" AutomationProperties.Name="Tamanho da fonte" SelectionChanged="FontSizeBox_OnSelectionChanged"><ComboBoxItem Content="9" Tag="12"/><ComboBoxItem Content="10" Tag="13.333"/><ComboBoxItem Content="11" Tag="14.667"/><ComboBoxItem Content="12" Tag="16"/><ComboBoxItem Content="14" Tag="18.667"/><ComboBoxItem Content="16" Tag="21.333"/><ComboBoxItem Content="18" Tag="24"/><ComboBoxItem Content="24" Tag="32"/><ComboBoxItem Content="36" Tag="48"/></ComboBox>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,8,0,0">
                                                            <TextBlock Text="ESTILO E CORES" Style="{StaticResource Lab.Shortcuts.RibbonLabel}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="ShortcutBoldButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Negrito (Ctrl+B)" AutomationProperties.Name="Negrito (Ctrl+B)" Click="Bold_OnClick"><lab:LabIcon Kind="Bold" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutItalicButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Itálico (Ctrl+I)" AutomationProperties.Name="Itálico (Ctrl+I)" Click="Italic_OnClick"><lab:LabIcon Kind="Italic" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutUnderlineButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Sublinhado (Ctrl+U)" AutomationProperties.Name="Sublinhado (Ctrl+U)" Click="Underline_OnClick"><lab:LabIcon Kind="Underline" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutTextColorButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Cor do texto" AutomationProperties.Name="Cor do texto" Click="Color_OnClick"><lab:LabIcon Kind="Palette" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutHighlightButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Marca-texto" AutomationProperties.Name="Marca-texto" Click="Highlight_OnClick"><lab:LabIcon Kind="Highlighter" Width="18" Height="18"/></Button>

                                                            </StackPanel>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <Border Height="1" Background="{DynamicResource Lab.line}" Margin="0,12,0,0"/>
                                                    <WrapPanel>
                                                        <StackPanel Margin="0,10,16,0">
                                                            <TextBlock Text="PARÁGRAFO E LISTAS" Style="{StaticResource Lab.Shortcuts.RibbonLabel}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="ShortcutAlignLeftButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Alinhar à esquerda" AutomationProperties.Name="Alinhar à esquerda" Click="AlignLeft_OnClick"><lab:LabIcon Kind="AlignLeft" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutAlignCenterButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Centralizar" AutomationProperties.Name="Centralizar" Click="AlignCenter_OnClick"><lab:LabIcon Kind="AlignCenter" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutAlignRightButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Alinhar à direita" AutomationProperties.Name="Alinhar à direita" Click="AlignRight_OnClick"><lab:LabIcon Kind="AlignRight" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutAlignJustifyButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Justificar" AutomationProperties.Name="Justificar" Click="ShortcutJustify_OnClick"><lab:LabIcon Kind="AlignJustify" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutBulletsButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Lista com marcadores" AutomationProperties.Name="Lista com marcadores" Click="Bullets_OnClick"><lab:LabIcon Kind="List" Width="18" Height="18"/></Button>
                                                                <Button x:Name="ShortcutNumberingButton" Style="{StaticResource Lab.Shortcuts.RibbonTool}" ToolTip="Lista numerada" AutomationProperties.Name="Lista numerada" Click="Numbering_OnClick"><lab:LabIcon Kind="ListOrdered" Width="18" Height="18"/></Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,10,0,0">
                                                            <TextBlock Text="INSERIR" Style="{StaticResource Lab.Shortcuts.RibbonLabel}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Style="{StaticResource Lab.Shortcuts.Ghost}" Height="34" Margin="0,0,4,0" Padding="7,5" ToolTip="Inserir link" AutomationProperties.Name="Inserir link" Click="Link_OnClick"><StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Link" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Link" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
                                                                <Button Style="{StaticResource Lab.Shortcuts.Ghost}" Height="34" Margin="0,0,4,0" Padding="7,5" ToolTip="Inserir imagem" AutomationProperties.Name="Inserir imagem" Click="Image_OnClick"><StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Image" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Imagem" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
                                                                <Button Style="{StaticResource Lab.Shortcuts.Ghost}" Height="34" Margin="0,0,4,0" Padding="7,5" ToolTip="Inserir tabela" AutomationProperties.Name="Inserir tabela" Click="Table_OnClick"><StackPanel Orientation="Horizontal"><lab:LabIcon Kind="Grid2X2" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Tabela" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>
                                                                <Button x:Name="ShortcutCodeButton" Style="{StaticResource Lab.Shortcuts.Ghost}" Height="34" Padding="7,5" ToolTip="Inserir bloco de código" AutomationProperties.Name="Inserir bloco de código" Click="InsertCodeBlock_OnClick"><StackPanel Orientation="Horizontal"><lab:LabIcon Kind="CodeXml" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Código" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/></StackPanel></Button>

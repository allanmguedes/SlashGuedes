                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Lab.Icon.Film}" Width="21" Height="21"
                                                  Stretch="Uniform" Stroke="{DynamicResource Lab.accent-text}"
                                                  StrokeThickness="1.7" Margin="0,0,9,0"/>

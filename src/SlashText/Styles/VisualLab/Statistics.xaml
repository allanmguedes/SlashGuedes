<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Statistics-only styles; frozen tokens and other screens stay untouched. -->
    <Style x:Key="Lab.Stats.MetricCard" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
        <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="8,0,8,8"/>
    </Style>
    <Style x:Key="Lab.Stats.Value" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}">
        <Setter Property="FontSize" Value="36"/><Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Lab.Stats.Title" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}">
        <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Lab.Stats.Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/><Setter Property="Maximum" Value="100"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Lab.input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Lab.accent}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>

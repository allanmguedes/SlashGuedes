<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Lab.About.Heading" TargetType="TextBlock" BasedOn="{StaticResource Lab.Heading}">
        <Setter Property="FontSize" Value="42"/><Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="LineHeight" Value="49"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Lab.About.Body" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/>
    </Style>
    <Style x:Key="Lab.About.Card" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
        <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="8,0,8,16"/>
    </Style>
    <Style x:Key="Lab.About.Badge" TargetType="Border">
        <Setter Property="Padding" Value="11,5"/><Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
        <Setter Property="Background" Value="{DynamicResource Lab.panel}"/><Setter Property="Margin" Value="5"/>
    </Style>
</ResourceDictionary>

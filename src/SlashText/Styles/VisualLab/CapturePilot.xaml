<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lab="clr-namespace:SlashText.Design">
    <!-- Production pilot for issue #63. All keys remain opt-in. -->
    <Style x:Key="Lab.Pilot.SliderTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Pilot.InkSlider" TargetType="Slider">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Lab.Pilot.SliderTrack}" Background="{DynamicResource Lab.accent}"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Width="18" Height="18">
                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border CornerRadius="9" Background="{DynamicResource Lab.accent}" BorderThickness="4" BorderBrush="{DynamicResource Lab.line-strong}"/>
                        </ControlTemplate></Thumb.Template>
                    </Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Lab.Pilot.SliderTrack}" Background="{DynamicResource Lab.muted}"/></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Pilot.ShellHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Lab.shell}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="Lab.Pilot.NavigationBar" TargetType="Border" BasedOn="{StaticResource Lab.Pilot.ShellHeader}">
        <Setter Property="Background" Value="{DynamicResource Lab.shell}"/>
    </Style>

    <Style x:Key="Lab.Pilot.NavigationButton" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="15,9"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="Indicator" Height="3" Margin="15,0"
                                VerticalAlignment="Bottom" CornerRadius="2"
                                Background="{DynamicResource Lab.accent}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.input}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lab.Pilot.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Lab.Heading}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="Lab.Pilot.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Lab.Metadata}">
        <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Lab.Pilot.CommandBar" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource Lab.raised}"/>
        <Setter Property="lab:LabMotion.Entrance" Value="Page"/>
    </Style>

    <Style x:Key="Lab.Pilot.Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
        <Setter Property="lab:LabMotion.Interactive" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" CornerRadius="5"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.panel}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lab.Pilot.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Lab.PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Lab.capture-primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Lab.capture-primary}"/>
    </Style>
    <Style x:Key="Lab.Pilot.NewButton" TargetType="Button" BasedOn="{StaticResource Lab.Pilot.PrimaryButton}">
        <Setter Property="MinWidth" Value="98"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Lab.Pilot.EditorTool" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="Padding" Value="10,7"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Selected">
                <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
                <Setter Property="Background" Value="{DynamicResource Lab.tint}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Lab.accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Lab.Pilot.ModeCard" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="76"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
        <Setter Property="Background" Value="{DynamicResource Lab.panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
        <Setter Property="lab:LabMotion.Interactive" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Border x:Name="Check" Width="18" Height="18" CornerRadius="9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource Lab.accent}" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Ui.1DABBA21CDAD4454}" Foreground="{DynamicResource Lab.on}"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.raised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lab.Pilot.ToolButton" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="9"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.input}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lab.Pilot.ToolGlyph" TargetType="lab:LabIcon">
        <Setter Property="Width" Value="19"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <Style x:Key="Lab.Pilot.ToolIcon" TargetType="Path">
        <Setter Property="Width" Value="19"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource Lab.text}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="Lab.Pilot.TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lab.Pilot.Card" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="lab:LabMotion.Entrance" Value="Page"/>
    </Style>

    <Style x:Key="Lab.Pilot.SubtleCard" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
        <Setter Property="Background" Value="{DynamicResource Lab.shell}"/>
        <Setter Property="Padding" Value="17"/>
    </Style>

    <Style x:Key="Lab.Pilot.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Lab.tint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
</ResourceDictionary>

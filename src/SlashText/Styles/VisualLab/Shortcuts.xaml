<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lab="clr-namespace:SlashText.Design">
    <Style x:Key="Lab.Shortcuts.HeightGrip" TargetType="Thumb">
        <Setter Property="Height" Value="16"/><Setter Property="Cursor" Value="SizeNS"/><Setter Property="Focusable" Value="True"/>
        <Setter Property="ToolTip" Value="{DynamicResource Ui.561E1F5693E8F1BB}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border x:Name="GripSurface" Background="Transparent" CornerRadius="4">
                <Border x:Name="Grip" Width="38" Height="3" CornerRadius="2" Background="{DynamicResource Lab.line-strong}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Lab.accent}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource Lab.tint}"/><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Lab.accent}"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Lab.accent}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Issue #64: scoped styles, same tokens/motion as the approved capture pilot. -->
    <Style x:Key="Lab.Shortcuts.Label" TargetType="TextBlock" BasedOn="{StaticResource Lab.Metadata}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="Lab.Shortcuts.Tool" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>
    <Style x:Key="Lab.Shortcuts.Filter" TargetType="Button" BasedOn="{StaticResource Lab.Shortcuts.Tool}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style x:Key="Lab.Shortcuts.Ghost" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <lab:LabContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.raised}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Shortcuts.RibbonTool" TargetType="Button" BasedOn="{StaticResource Lab.Shortcuts.Ghost}">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Style.Triggers><Trigger Property="Tag" Value="Selected">
            <Setter Property="Background" Value="{DynamicResource Lab.tint}"/>
            <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Lab.Shortcuts.RibbonLabel" TargetType="TextBlock" BasedOn="{StaticResource Lab.Metadata}">
        <Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Lab.Shortcuts.Item" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.panel}"/>
                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.raised}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Shortcuts.Variable" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Lab.input}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <lab:LabContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    <lab:LabIcon Kind="Plus" Width="12" Height="12" Grid.Column="1" Margin="6,0,0,0" Foreground="{DynamicResource Lab.muted}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/><Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.raised}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>

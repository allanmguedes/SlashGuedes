<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lab="clr-namespace:SlashText.Design">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Tokens.xaml"/>
  <ResourceDictionary Source="Light.xaml"/>
  <ResourceDictionary Source="Icons.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <!-- Opt-in only. No implicit style may escape into the existing application. -->
 <Style x:Key="Lab.Focus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Lab.accent}"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.Text" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/>
  <Setter Property="FontSize" Value="{StaticResource Lab.BodySize}"/>
  <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="Lab.Heading" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}">
  <Setter Property="FontSize" Value="{StaticResource Lab.HeadingSize}"/>
  <Setter Property="FontFamily" Value="{StaticResource Lab.DisplayFont}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="Lab.Metadata" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}">
  <Setter Property="FontSize" Value="{StaticResource Lab.MetadataSize}"/>
  <Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
 </Style>
 <Style x:Key="Lab.Button" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/>
  <Setter Property="FontSize" Value="{StaticResource Lab.BodySize}"/>
  <Setter Property="MinHeight" Value="{StaticResource Lab.ControlHeight}"/>
  <Setter Property="Padding" Value="13,8"/>
  <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
  <Setter Property="Background" Value="{DynamicResource Lab.panel}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
  <Setter Property="lab:LabMotion.Interactive" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Lab.ButtonRadius}">
    <Border x:Name="Bottom" BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="0,0,0,1"
      CornerRadius="{StaticResource Lab.ButtonRadius}" Padding="{TemplateBinding Padding}">
     <lab:LabContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
      TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.raised}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.input}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
  <Setter Property="Background" Value="{DynamicResource Lab.accent}"/>
  <Setter Property="Foreground" Value="{DynamicResource Lab.on}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Lab.accent}"/>
  <!-- Keep on-accent foreground on hover; do not inherit the neutral hover fill. -->
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
     CornerRadius="{StaticResource Lab.ButtonRadius}" Padding="{TemplateBinding Padding}">
    <Grid><lab:LabContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
     <Border x:Name="Hover" Background="White" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.Field" TargetType="TextBox">
  <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
  <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="Padding" Value="11,9"/><Setter Property="MinHeight" Value="38"/>
  <Setter Property="Background" Value="{DynamicResource Lab.input}"/><Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
  <Setter Property="CaretBrush" Value="{DynamicResource Lab.text}"/><Setter Property="SelectionBrush" Value="{DynamicResource Lab.accent}"/>
  <Setter Property="SelectionOpacity" Value="0.3"/><Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
    <Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
     <Border x:Name="Underline" BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="0,0,0,1" CornerRadius="5" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2"/></Trigger>
    <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Lab.error}"/><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Lab.error}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.ComboItem" TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="11,9"/><Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
    <lab:LabContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.tint}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.Combo" TargetType="ComboBox">
  <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
  <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="11,9"/>
  <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/><Setter Property="Background" Value="{DynamicResource Lab.input}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/><Setter Property="ItemContainerStyle" Value="{StaticResource Lab.ComboItem}"/>
  <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <ToggleButton x:Name="DropToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Frame" Background="{DynamicResource Lab.input}" BorderBrush="{DynamicResource Lab.line}" BorderThickness="1" CornerRadius="5">
       <Path Data="M 0 0 L 4 4 8 0" Stroke="{DynamicResource Lab.muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <lab:LabContentPresenter x:Name="Selection" TextElement.Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="11,9,32,9" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="1,1,30,1" Style="{StaticResource Lab.Field}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
    <Border x:Name="Underline" BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="0,0,0,1" CornerRadius="5" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
     <Border x:Name="PopupSurface" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
      Background="{DynamicResource Lab.raised}" BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
      <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Selection" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2"/></Trigger>
    <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Lab.error}"/><Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.Switch" TargetType="CheckBox">
  <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="MinHeight" Value="54"/><Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
  <Setter Property="lab:LabMotion.Switch" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Border BorderBrush="{DynamicResource Lab.line}" BorderThickness="0,0,0,1">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="39"/></Grid.ColumnDefinitions>
     <lab:LabContentPresenter VerticalAlignment="Center" Margin="0,0,15,0" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
     <Grid Grid.Column="1" Width="39" Height="21">
      <Border x:Name="Track" Background="{DynamicResource Lab.input}" BorderBrush="{DynamicResource Lab.muted}" BorderThickness="1" CornerRadius="11"/>
      <Ellipse x:Name="Thumb" Width="11" Height="11" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Lab.muted}">
       <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
     </Grid>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Lab.on}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.Tab" TargetType="RadioButton">
  <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="Padding" Value="15,10"/><Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid><Border x:Name="Surface" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
    <lab:LabContentPresenter RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border><Border x:Name="Indicator" Height="3" Margin="15,0" VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource Lab.accent}" Visibility="Hidden"/></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Lab.input}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Lab.Card" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Lab.panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Lab.line}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Lab.CardRadius}"/><Setter Property="Padding" Value="{StaticResource Lab.CardPadding}"/>
 </Style>
 <Style x:Key="Lab.Popup" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
  <Setter Property="Background" Value="{DynamicResource Lab.raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Lab.line-strong}"/><Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="10"/>
  <Setter Property="lab:LabMotion.Entrance" Value="Popup"/>
 </Style>
 <Style x:Key="Lab.Icon" TargetType="lab:LabIcon">
  <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
  <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
 </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lab="clr-namespace:SlashText.Design">
 <!-- Fixed colors depict the three theme samples, independently of the current theme. -->
 <SolidColorBrush x:Key="Lab.Settings.Preview.Light" Color="#F1F2F5"/>
 <SolidColorBrush x:Key="Lab.Settings.Preview.LightPanel" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="Lab.Settings.Preview.Dark" Color="#111111"/>
 <SolidColorBrush x:Key="Lab.Settings.Preview.DarkPanel" Color="#262626"/>
 <SolidColorBrush x:Key="Lab.Settings.Preview.LightAccent" Color="#008497"/>
 <SolidColorBrush x:Key="Lab.Settings.Preview.DarkAccent" Color="#4EDAE9"/>
 <SolidColorBrush x:Key="Lab.Settings.Preview.SystemPanel" Color="#83959A"/>
 <LinearGradientBrush x:Key="Lab.Settings.Preview.System" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EEEEEE" Offset="0"/><GradientStop Color="#EEEEEE" Offset="0.5"/><GradientStop Color="#111111" Offset="0.5"/><GradientStop Color="#111111" Offset="1"/></LinearGradientBrush>
 <Style x:Key="Lab.Settings.Card" TargetType="Border" BasedOn="{StaticResource Lab.Card}"><Setter Property="Margin" Value="0,0,0,20"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style>
 <Style x:Key="Lab.Settings.Title" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="Lab.Settings.Icon" TargetType="lab:LabIcon"><Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="Lab.Settings.Theme" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
  <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Stretch" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
